{
  "name": "shenzhen-drive",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "playtest": "vite build --outDir playtest --emptyOutDir && vite preview --outDir playtest --port 4173 --strictPort",
    "playtest:next": "vite build --outDir playtest-next --emptyOutDir && vite preview --outDir playtest-next --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "data": ".venv/bin/python scripts/build_city_data.py",
    "data:metro": ".venv/bin/python scripts/build_metro_data.py"
  },
  "dependencies": {
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
